{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-locator.dev/schemas/v1/local-server-card.schema.json",
  "title": "Local Server Card",
  "description": "Registers one MCP server with the machine. Superset of the SEP-2127 server card identity fields plus a `local` block. See spec/001.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "description": "Reverse-DNS identifier; must match the card's filename (<name>.card.json).",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?){1,}$",
      "maxLength": 200
    },
    "version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "title": { "type": "string", "maxLength": 100 },
    "websiteUrl": { "type": "string" },
    "icons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": { "type": "string" },
          "mimeType": { "type": "string" },
          "sizes": { "type": "string" },
          "theme": { "enum": ["light", "dark"] }
        },
        "required": ["src"],
        "additionalProperties": false
      }
    },
    "repository": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "source": { "type": "string" },
        "subfolder": { "type": "string" }
      },
      "additionalProperties": true
    },
    "remotes": {
      "type": "array",
      "description": "SEP-2127 remotes, verbatim. Kept intentionally loose; SEP-2127 owns this shape.",
      "items": {
        "type": "object",
        "properties": {
          "type": { "enum": ["streamable-http", "sse"] },
          "url": { "type": "string" }
        },
        "required": ["type", "url"],
        "additionalProperties": true
      }
    },
    "local": {
      "type": "object",
      "properties": {
        "launch": {
          "type": "object",
          "properties": {
            "type": { "enum": ["stdio", "executable"] },
            "command": { "type": "string", "minLength": 1 },
            "args": { "type": "array", "items": { "type": "string" } },
            "cwd": { "type": ["string", "null"] },
            "env": { "type": "object", "additionalProperties": { "type": "string" } },
            "shared": { "type": "boolean", "default": false }
          },
          "required": ["type", "command"],
          "additionalProperties": false
        },
        "endpoint": {
          "type": "object",
          "properties": {
            "type": { "enum": ["pipe", "unix-socket", "streamable-http"] },
            "address": { "type": "string", "minLength": 1 }
          },
          "required": ["type", "address"],
          "additionalProperties": false
        },
        "liveness": {
          "type": "object",
          "properties": {
            "pidFile": { "type": "string" },
            "probe": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        },
        "lifetime": {
          "type": "object",
          "properties": {
            "idleTimeoutSeconds": { "type": "integer", "minimum": 0 },
            "shutdown": { "enum": ["graceful", "kill"], "default": "graceful" }
          },
          "additionalProperties": false
        },
        "consent": {
          "type": "object",
          "properties": {
            "summary": { "type": "string", "maxLength": 500 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": { "launch": { "properties": { "type": { "const": "executable" } }, "required": ["type"] } },
        "required": ["launch"]
      },
      "then": {
        "required": ["endpoint"]
      }
    },
    "_meta": { "type": "object" }
  },
  "required": ["name", "version", "description"],
  "additionalProperties": false,
  "anyOf": [
    { "properties": { "local": { "required": ["launch"] } }, "required": ["local"] },
    { "properties": { "local": { "required": ["endpoint"] } }, "required": ["local"] },
    { "properties": { "remotes": { "type": "array", "minItems": 1 } }, "required": ["remotes"] }
  ]
}
