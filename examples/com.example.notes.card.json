{
  "$schema": "https://mcp-locator.dev/schemas/v1/local-server-card.schema.json",
  "name": "com.example.notes",
  "version": "2.0.1",
  "title": "Example Notes",
  "description": "Search and create notes in the Example Notes desktop app.",
  "websiteUrl": "https://example.com/notes",
  "remotes": [],
  "local": {
    "launch": {
      "type": "stdio",
      "command": "%ProgramFiles%\\Example Notes\\notes-mcp.exe",
      "args": ["--serve"],
      "env": {}
    },
    "liveness": {
      "pidFile": "%LOCALAPPDATA%\\ExampleNotes\\notes-mcp.pid",
      "probe": false
    },
    "lifetime": {
      "idleTimeoutSeconds": 300,
      "shutdown": "graceful"
    },
    "consent": {
      "summary": "Can read, search, and create notes in your Example Notes library."
    }
  },
  "_meta": {}
}
